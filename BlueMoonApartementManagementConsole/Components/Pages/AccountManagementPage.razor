@page "/quan-tri/tai-khoan"
@attribute [Authorize(Policy = "QuanTriHeThong")]
@layout BlueMoonApartementManagementConsole.Components.Layout.DashboardLayout

@using Microsoft.AspNetCore.Authorization

<PageTitle>Tài khoản & phân quyền - Bluemoon</PageTitle>

<section class="page">
    <div class="page-head">
        <h1>Tài khoản & phân quyền</h1>
        <p class="muted">
            Tài khoản cư dân: thao tác được với mọi BQT. Tài khoản BQT và Kế toán: chỉ thao tác với tài khoản thuộc nhánh do mình cấp.
        </p>
    </div>

    <div id="accAlert" class="alert" role="alert" hidden></div>

    <div id="tempBox" class="temp-box" hidden>
        <div>Mật khẩu tạm cho <strong id="tempUser"></strong>: <code id="tempValue"></code></div>
        <div class="temp-actions">
            <button type="button" id="tempCopy" class="btn-link">Sao chép</button>
            <button type="button" id="tempClose" class="btn-link">Đã ghi lại, đóng</button>
        </div>
        <p class="muted small">Mật khẩu chỉ hiển thị một lần. Người dùng phải đổi mật khẩu ở lần đăng nhập tiếp theo.</p>
    </div>

    <details class="card-box">
        <summary>Tạo tài khoản mới</summary>
        <form id="createForm" class="filter-bar">
            <label>Tài khoản
                <input name="username" maxlength="50" required />
            </label>
            <label>Tên người dùng
                <input name="fullName" maxlength="100" required />
            </label>
            <label>Vai trò
                <select name="role">
                    <option value="CU_DAN">Cư dân</option>
                    <option value="KE_TOAN">Kế toán</option>
                    <option value="BQT">Ban quản trị</option>
                </select>
            </label>
            <div class="filter-actions">
                <button type="submit" class="btn-approve">Tạo tài khoản</button>
            </div>
        </form>
    </details>

    <form id="accFilter" class="filter-bar">
        <label>Tìm kiếm
            <input type="search" name="q" placeholder="Tài khoản hoặc tên" />
        </label>
        <label>Vai trò
            <select name="role">
                <option value="">Tất cả</option>
                <option value="BQT">Ban quản trị</option>
                <option value="KE_TOAN">Kế toán</option>
                <option value="CU_DAN">Cư dân</option>
            </select>
        </label>
        <label>Trạng thái
            <select name="status">
                <option value="">Tất cả</option>
                <option value="active">Đang hoạt động</option>
                <option value="disabled">Đã vô hiệu hóa</option>
            </select>
        </label>
    </form>

    <div id="accLoading" class="empty-state">Đang tải danh sách...</div>
    <div id="accEmpty" class="empty-state" hidden>Không có tài khoản phù hợp.</div>

    <div id="accTable" class="table-wrap" hidden>
        <table class="data-table">
            <thead>
                <tr>
                    <th>Tài khoản</th>
                    <th>Họ tên</th>
                    <th>Vai trò</th>
                    <th>Người cấp</th>
                    <th>Trạng thái</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="accBody"></tbody>
        </table>
    </div>
</section>